# ─── Aura Frontend Environment ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Vite requires all client-side env vars to be prefixed with VITE_

# API base URL
# Local development: leave empty (Vite proxy handles it)
# Production: set to your deployed backend, e.g. https://aura-backend.onrender.com/api
VITE_API_URL=
